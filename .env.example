# The one environment template for client-portfolio.
#
# Local development: copy to .env (git ignores it) and fill in the blanks.
# Production: the API is the Render web service client-portfolio-backend, and
# every server variable below is set on its Environment page in the Render
# dashboard, never in a file (deploy/README.md, "Environment variables").
# Placeholders in <angle brackets> are not values; never commit real ones.

# ---------------------------------------------------------------- server ----

# development locally; production on Render (Secure SameSite=None cookie,
# HTTPS redirect, FRONTEND_URL as the only allowed browser origin).
NODE_ENV=development

# Port the API listens on. Locally 5000; on Render, confirm in the dashboard
# whether PORT is set (Render tells the service which port to bind).
PORT=5000

# Postgres. Locally: postgres://<user>:<password>@localhost:5432/<database>.
# On Render: the Render database's connection URL, set in the dashboard. Do not
# add ?sslmode=...: pg lets it override DATABASE_SSL.
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>

# TLS to Postgres: false (local), no-verify (Render), or verify (then set
# DATABASE_SSL_CA to a CA file). Any other value stops the server at startup.
DATABASE_SSL=false
# DATABASE_SSL_CA=<path to ca.pem>

# Signs the session JWT; changing it signs every partner out. Left empty on
# purpose: the server refuses to start without it. Generate 48 random bytes
# (works in bash, cmd and PowerShell, since Node is installed):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# or, in bash only: openssl rand -base64 48
# Never reuse the production value locally.
JWT_SECRET=

# One lifetime for the JWT and the auth cookie: <number><d|h|m>. Default 7d.
SESSION_TTL=7d

# The one browser origin allowed to call the API in production
# (Render: https://gbacpod.com). Unset in production means no browser origin is
# allowed. Ignored in development, which allows localhost:3000 and :5173.
FRONTEND_URL=

# Proxies in front of the API (Render: 1). Leave 0 locally, where nothing sets
# X-Forwarded-For honestly.
TRUST_PROXY_HOPS=0

# bcrypt cost for new and reset passwords. Default 12.
BCRYPT_SALT_ROUNDS=12

# ---------------------------------------------------------------- AI --------

# services/anthropic.cjs. Without a key every AI button reports "not
# configured" and /api/health reports DEGRADED. (CLAUDE_API_KEY is still read
# as a legacy fallback name; use ANTHROPIC_API_KEY.)
ANTHROPIC_API_KEY=
# One model for every AI call (D7); claude-sonnet-5 is the cheaper alternative.
AI_MODEL=claude-opus-5
# How hard the model works on each answer, the cost and latency lever (T11):
# low, medium, high, xhigh or max. Unset means the API's default (high on
# claude-opus-5). Any other value stops the server at start.
# AI_EFFORT=medium

# For local tests only: sends AI calls to a fake Anthropic server, e.g.
# http://127.0.0.1:5099 from node tests/helpers/fakeAnthropic.mjs --port 5099
# (with any non-empty ANTHROPIC_API_KEY, such as test). Ignored in production,
# where AI calls always go to https://api.anthropic.com. Never set it on Render.
# ANTHROPIC_BASE_URL=http://127.0.0.1:5099

# ---------------------------------------------------------------- page ------

# VITE_API_BASE_URL is read by Vite at BUILD time, not by the server, so it
# does not belong in the server's environment:
# - Netlify: a build variable in the Netlify UI (Project configuration >
#   Environment variables), https://client-portfolio-backend.onrender.com, for
#   the Production and Deploy Previews contexts. netlify.toml does not set it.
# - Local production build: VITE_API_BASE_URL=https://<api host> npm run build:prod
#   (vite.config.js refuses a production build without an https:// value).
# - Local development: start Vite with VITE_API_BASE_URL=http://localhost:5000;
#   without it the page calls relative /api, which Vite does not proxy.

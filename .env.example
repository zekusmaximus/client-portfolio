# Server environment. Local development: copy to .env. Production (Render):
# these are set in the Render dashboard, not in a file. WP5 finalises this file.

NODE_ENV=development
PORT=5000

# Postgres. Do not add ?sslmode=... here: pg lets it override DATABASE_SSL.
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<db>
# TLS to Postgres: false (default, local), no-verify (Render), or verify
# (optionally with DATABASE_SSL_CA=/path/to/ca.pem).
DATABASE_SSL=false

# Signs the session JWT. Generate with: openssl rand -base64 48
JWT_SECRET=change_me
BCRYPT_SALT_ROUNDS=12
# One lifetime for the JWT and the auth cookie: <number><d|h|m>.
SESSION_TTL=7d

# Browser origin allowed to call the API in production (Render: https://gbacpod.com).
FRONTEND_URL=
# Proxies in front of the app (Render: 1). Leave 0 locally, where nothing sets
# X-Forwarded-For honestly.
TRUST_PROXY_HOPS=0

# AI (services/anthropic.cjs). Without a key every AI button reports "not configured".
ANTHROPIC_API_KEY=
# One model for every AI call; claude-sonnet-5 is the cheaper alternative.
AI_MODEL=claude-opus-5

# Build-time, read by Vite rather than the server: VITE_API_BASE_URL
# (Netlify build: the Render backend's https:// URL).

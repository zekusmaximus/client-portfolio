DATABASE_URL=postgres://<user>:<password>@<host>:5432/<db>?sslmode=require
PORT=5000
JWT_SECRET=change_me
BCRYPT_SALT_ROUNDS=12

# AI (services/anthropic.cjs). Without a key every AI button reports "not configured".
ANTHROPIC_API_KEY=
# One model for every AI call; claude-sonnet-5 is the cheaper alternative.
AI_MODEL=claude-opus-5
